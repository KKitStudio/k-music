# ============================================================
# K曲库 (musicMT) — Git 忽略规则
# 原则：仓库只放源码 / 对外说明（README）/ 可重建脚本；
#       内部文档(docs)、会话笔记(.workbuddy)、协作说明(CODEBUDDY.md)、
#       版本全表(VERSION.md)、待办(TODO.md)、历史图标与第三方工具一律不入库；
#       应用图标仅发布 icon.ico/icon.png/icon.svg，demo 测试目录不入库（见 TODO.md 发布流水线）。
#       本地仓库保留全量文件（不删除磁盘），仅推送到远程时按本文件裁剪为子集。
# ============================================================

# --- 构建产物（二进制走 Release，不进仓库） ---
/target/
/dist/
**/*.o
**/*.obj
**/*.pdb
**/*.rlib
**/*.rmeta
**/*.d

# --- 运行时数据 / 本机配置（含曲库绝对路径、凭证、日志） ---
kqk-app.toml
kqk-window.state
kqk-window.state.tmp
kqk-instance.port
kqk-instance.port.tmp
musicmt-launcher.toml
musicmt-guest.toml
.guest/
.mt/
musiclibrary/
/app/data/
*.db
*.db-shm
*.db-wal
*.log

# --- 仅本地 / 私有的项目文件（不随 GitHub 发布） ---
# 根目录这些文件属于内部协作 / 版本全表 / 待办，不公开。
VERSION.md
TODO.md
CODEBUDDY.md
# 内部设计文档（不公开）
/docs/

# --- 应用图标：仅发布 icon.ico / icon.png / icon.svg（备份与候选目录不发布） ---
/app/gui/icons/*
!/app/gui/icons/icon.ico
!/app/gui/icons/icon.png
!/app/gui/icons/icon.svg

# --- demo 测试目录（含夹具绝对路径，可由脚本重建）不发布 ---
/demo/

# --- 第三方工具与打包脚本（合规：NCM 解密工具不内置也不公开分享） ---
# tools/ 整体不发布，仅保留 package_gui.bat 供贡献者本地一键打包。
/tools/*
!tools/package_gui.bat

# --- WorkBuddy 会话数据：本地多会话共享用，不发布到远程（含 memory 笔记） ---
/.workbuddy/

# --- 临时预览 / 验证文件 ---
_icon_*.png
_icon_*.html
_icon_raw.*
_verify.*
_preview.html
_shot_*.png
*.new
